# ─── Server ───────────────────────────────────────────────────
PORT=5000
NODE_ENV=production
LOG_LEVEL=info

# ─── Database ─────────────────────────────────────────────────
# Set this to your MongoDB Atlas connection string in deployment
MONGODB_URI=mongodb://127.0.0.1:27017/queuepulse

# ─── CORS ─────────────────────────────────────────────────────
# Set to your deployed frontend URL (no trailing slash)
# Examples:
#   Railway:  https://queuepulse-frontend.up.railway.app
#   Vercel:   https://queuepulse.vercel.app
CLIENT_URL=http://localhost:5173
CORS_ALLOW_PRIVATE_NETWORK=true

# ─── Auth ─────────────────────────────────────────────────────
# IMPORTANT: Replace with a strong random secret in production
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_IN_PRODUCTION_USE_64_RANDOM_HEX_CHARS
JWT_EXPIRY=24h
BCRYPT_ROUNDS=10

# ─── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_GENERAL=100
RATE_LIMIT_AUTH=10
RATE_LIMIT_REGISTRATION=20
RATE_LIMIT_STRICT=30

# ─── Consultation Settings ────────────────────────────────────
DEFAULT_CONSULTATION_MINUTES=8
CONSULTATION_HISTORY_SIZE=10

# ─── Logging ──────────────────────────────────────────────────
LOG_DIR=logs
LOG_ERROR_FILE=error.log
LOG_COMBINED_FILE=combined.log

# ─── Validation Bounds ────────────────────────────────────────
AGE_MIN=0
AGE_MAX=150
CONSULTATION_MIN=1
CONSULTATION_MAX=1440
NAME_MIN=2
NAME_MAX=100
REASON_MAX=500
PHONE_MAX=32
PASSWORD_MIN=6
PASSWORD_MAX=128

# ─── Queue Health Thresholds ──────────────────────────────────
QUEUE_HEALTH_CRITICAL_PATIENTS=15
QUEUE_HEALTH_CRITICAL_MINUTES=120
QUEUE_HEALTH_BUSY_PATIENTS=10
QUEUE_HEALTH_BUSY_MINUTES=60
QUEUE_HEALTH_STEADY_PATIENTS=5
QUEUE_HEALTH_STEADY_MINUTES=30

# ─── Efficiency Score Calculations ────────────────────────────
EFFICIENCY_MAX_WAIT_PENALTY=30
EFFICIENCY_MAX_QUEUE_PENALTY=20
EFFICIENCY_SPEED_BONUS=10
EFFICIENCY_SPEED_THRESHOLD=5

# ─── Rate Limit Windows (milliseconds) ────────────────────────
RATE_LIMIT_GENERAL_WINDOW_MS=900000
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_REGISTRATION_WINDOW_MS=60000
RATE_LIMIT_STRICT_WINDOW_MS=900000
