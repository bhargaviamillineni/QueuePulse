# ─── Frontend Production Config ───────────────────────────────

# Option A: Explicit full API URL (recommended for deployment)
# Set this to your deployed backend URL — no trailing slash
# VITE_API_URL=https://your-backend.up.railway.app

# Option B: Auto-detect (used in local dev if VITE_API_URL is not set)
VITE_API_PROTOCOL=https:
VITE_API_PORT=5000

# Dev server
VITE_HOST=0.0.0.0
VITE_PORT=5173
VITE_PREVIEW_PORT=4173
